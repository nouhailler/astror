    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "video:setup": "video-studio setup",
    "video:list": "video-studio list",
    "video:validate": "video-studio validate",
    "video:audio": "video-studio audio",
    "video:record": "video-studio record",
    "video:timeline": "video-studio timeline",
    "video:render": "video-studio render",
    "video:generate": "video-studio generate",
    "video:preview": "video-studio preview",
    "video:typecheck": "tsc -p video/tsconfig.json"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satellite.js": "^4.1.4"
