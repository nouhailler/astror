{
  "name": "astror",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "description": "Compagnon d'observation astronomique — PWA en français pour astronomes amateurs (carte du ciel, éphémérides, outils d'observation et d'astrophoto, veille spatiale, assistant IA).",
  "author": "Patrick Nouhailler <contact@swinux.ch> (https://swinux.ch)",
  "license": "MIT",
  "homepage": "https://astror.swinux.ch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nouhailler/astror.git"
  },
  "bugs": {
    "url": "https://github.com/nouhailler/astror/issues"
  },
  "keywords": [
    "astronomy",
    "pwa",
    "react",
    "vite",
    "stargazing",
    "astrophotography"
  ],
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "video:setup": "bash video/scripts/setup.sh",
    "video:list": "tsx video/scripts/cli.ts list",
    "video:validate": "tsx video/scripts/cli.ts validate",
    "video:audio": "tsx video/scripts/cli.ts audio",
    "video:record": "tsx video/scripts/cli.ts record",
    "video:timeline": "tsx video/scripts/cli.ts timeline",
    "video:render": "tsx video/scripts/cli.ts render",
    "video:generate": "tsx video/scripts/cli.ts generate",
    "video:preview": "tsx video/scripts/cli.ts preview",
    "video:test": "vitest run --config video/vitest.config.ts",
    "video:typecheck": "tsc -p video/tsconfig.json"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satellite.js": "^4.1.4"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "remotion": "4.0.539",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^4.1.8",
    "workbox-window": "^7.3.0"
  }
}
