  "devDependencies": {
    "@nouhailler/video-studio": "github:nouhailler/video-studio#v0.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.10",
