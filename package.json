{
  "name": "astror",
  "private": true,
  "version": "1.6.2",
  "type": "module",
  "description": "Compagnon d'observation astronomique — PWA en français pour astronomes amateurs (carte du ciel, éphémérides, outils d'observation et d'astrophoto, veille spatiale, assistant IA).",
  "author": "Patrick Nouhailler <contact@swinux.ch> (https://swinux.ch)",
  "license": "MIT",
  "homepage": "https://astror.swinux.ch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nouhailler/astror.git"
  },
  "bugs": {
    "url": "https://github.com/nouhailler/astror/issues"
  },
  "keywords": [
    "astronomy",
    "pwa",
    "react",
    "vite",
    "stargazing",
    "astrophotography"
  ],
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  },
  "scripts": {
