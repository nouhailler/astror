# Cloudflare Pages — en-têtes HTTP de l'application Astror.
# Copié tel quel dans dist/ par Vite (dossier public/). Non précaché par le
# service worker (aucune extension listée dans workbox.globPatterns).
#
# Toutes les pages : capteurs d'orientation autorisés pour la boussole de la
# carte du ciel (reprise de netlify.toml) + en-têtes de sécurité de base.
/*
  Permissions-Policy: accelerometer=(self), gyroscope=(self), magnetometer=(self)
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fichiers sans empreinte : toujours revalidés, pour que les mises à jour de la
# PWA (registerType: autoUpdate) soient détectées immédiatement.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Fichiers générés par Vite, avec empreinte dans le nom : cache long.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable
